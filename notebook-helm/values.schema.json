{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values",
  "type": "object",
  "properties": {
    "ha": {
      "type": "object",
      "properties": {
        "antiAffinity": {
          "type": "string",
          "enum": [
            "soft",
            "hard",
            "none"
          ]
        },
        "topologyKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "updateStrategy": {
      "type": "object",
      "properties": {
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "maxSurge": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array"
        }
      }
    },
    "existingSecret": {
      "type": "string"
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "NodePort",
            "ClusterIP"
          ]
        },
        "port": {
          "type": "integer"
        },
        "nodePort": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "externalTrafficPolicy": {
          "type": "string"
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "oidc",
            "no-oidc",
            "ldap"
          ]
        },
        "admins": {
          "type": "array"
        },
        "allowUnverified": {
          "type": "boolean"
        },
        "oidc": {
          "type": "object",
          "properties": {
            "jwt": {
              "type": "object",
              "properties": {
                "issuer": {
                  "type": "string"
                },
                "audience": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "jwksUrl": {
                  "type": "string"
                },
                "usernameClaim": {
                  "type": "string"
                },
                "allowedAlgorithms": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "RS256",
                      "RS384",
                      "RS512",
                      "ES256",
                      "ES384",
                      "ES512",
                      "PS256",
                      "PS384",
                      "PS512"
                    ]
                  }
                }
              }
            },
            "ui": {
              "type": "object",
              "properties": {
                "clientId": {
                  "type": "string"
                },
                "clientSecret": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                }
              }
            },
            "authorizationEndpoint": {
              "type": "string"
            },
            "tokenEndpoint": {
              "type": "string"
            },
            "endSessionEndpoint": {
              "type": "string"
            },
            "redirectUri": {
              "type": "string"
            },
            "sessionTimeout": {
              "type": "string",
              "pattern": "^(P.+|[0-9]+(ms|s|m|h|d))$"
            },
            "serviceAccount": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "clientId": {
                  "type": "string"
                },
                "clientSecret": {
                  "type": "string"
                }
              }
            }
          }
        },
        "session": {
          "type": "object",
          "properties": {
            "ttl": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h|d)$"
            },
            "recheck": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h|d)$"
            }
          }
        },
        "ldap": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "connectTimeout": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h|d)$"
            },
            "readTimeout": {
              "type": "string",
              "pattern": "^[0-9]+(ms|s|m|h|d)$"
            },
            "trustStore": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "PKCS12",
                    "JKS",
                    "PEM"
                  ]
                }
              }
            },
            "serviceAccount": {
              "type": "object",
              "properties": {
                "username": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                }
              }
            },
            "baseDN": {
              "type": "string"
            },
            "domain": {
              "type": "string"
            },
            "binddn": {
              "type": "string"
            },
            "bindpw": {
              "type": "string"
            },
            "guidKey": {
              "type": "string"
            },
            "userDNPattern": {
              "type": "string"
            },
            "groupDNPattern": {
              "type": "string"
            },
            "groupClassKey": {
              "type": "string"
            },
            "groupMembershipKey": {
              "type": "string"
            },
            "userMembershipKey": {
              "type": "string"
            },
            "customLDAPQuery": {
              "type": "string"
            },
            "groupFilter": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "userFilter": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "kyuubi": {
      "type": "object",
      "properties": {
        "connectTimeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h|d)$"
        },
        "requestTimeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h|d)$"
        },
        "idleSessionTimeout": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h|d)$"
        },
        "idleReaperIntervalMs": {
          "type": "integer",
          "minimum": 10000
        }
      }
    },
    "notebook": {
      "type": "object",
      "properties": {
        "maxCells": {
          "type": "integer"
        },
        "cellSourceMaxSize": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi)?$"
        },
        "documentMaxSize": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi)?$"
        },
        "importMaxSize": {
          "type": "string",
          "pattern": "^[0-9]+(Ki|Mi|Gi)?$"
        },
        "maxRevisions": {
          "type": "integer"
        },
        "resultsMaxRows": {
          "type": "integer"
        },
        "eventsPoolSize": {
          "type": "integer"
        },
        "eventsMaxWait": {
          "type": "string",
          "pattern": "^[0-9]+(ms|s|m|h|d)$"
        }
      }
    }
  }
}
